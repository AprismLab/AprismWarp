{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprismwarp.local/schema/awe/v1",
  "title": "AprismWarp Editor Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name", "permissions"],
  "properties": {
    "schema": {"const": "aprismwarp.extension/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "permissions": {"type": "array", "items": {"type": "string", "enum": ["editor.blocks", "editor.panels", "project.read", "project.write", "compiler.adapter", "host.mdl", "host.language-server"]}, "uniqueItems": true},
    "contributes": {"type": "object", "additionalProperties": false, "properties": {"blocks": {"type": "string", "pattern": "^blocks\\.json$"}, "panels": {"type": "array", "items": {"type": "string", "pattern": "^panels/.+\\.json$"}}, "templates": {"type": "string", "pattern": "^templates/$"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["entry", "trusted"], "properties": {"entry": {"type": "string", "pattern": "^runtime/.+\\.(js|mjs)$"}, "trusted": {"const": true}}}
  }
}
