{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprismwarp.local/schema/awp/v1",
  "title": "AprismWarp Project Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "schemaVersion", "projectId", "name", "workType", "target", "source"],
  "properties": {
    "format": {"const": "aprismwarp-project"},
    "schemaVersion": {"type": "integer", "const": 1},
    "projectId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "name": {"type": "string", "minLength": 1},
    "workType": {"type": "string", "enum": ["AprismJEMod", "AprismExtension"]},
    "workProfile": {"type": "object", "required": ["minecraftVersion", "aprismVersion", "workType"], "properties": {"minecraftVersion": {"type": "string", "minLength": 1}, "aprismVersion": {"type": "string", "minLength": 1}, "workType": {"type": "string", "enum": ["AprismJEMod", "AprismExtension"]}}, "additionalProperties": true},
    "extensions": {"type": "object", "additionalProperties": false, "properties": {"aepCapabilities": {"type": "array", "items": {"$ref": "#/$defs/lockedExtension"}, "uniqueItems": true}, "aweEditors": {"type": "array", "items": {"$ref": "#/$defs/lockedExtension"}, "uniqueItems": true}}},
    "target": {
      "type": "object",
      "required": ["aprism", "edition", "minecraft"],
      "properties": {
        "aprism": {"type": "string", "minLength": 1},
        "edition": {"const": "JE"},
        "minecraft": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["editor", "project", "ir"],
      "properties": {
        "editor": {"const": "aprismwarp-native"},
        "project": {"const": "editor/project.json"},
        "ir": {"const": "ir/project.json"}
      },
      "additionalProperties": true
    },
    "resources": {"const": "resources/"}
  },
  "$defs": {
    "lockedExtension": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}
  }
}
